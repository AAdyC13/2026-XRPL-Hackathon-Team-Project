{
  "info": {
    "_postman_id": "a-platform-xrpl-hackathon",
    "name": "A 平台 XRPL API（Testnet）",
    "description": "後端基礎設施 REST API。發幣端點由 server 使用 .env 的 ISSUER_SEED 簽署；請先確認 holder 已建立 Trust Line。\n\n集合變數請自行填寫：baseUrl、holderAddress、issueAmount 等。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "holderAddress",
      "value": "rYOUR_HOLDER_ADDRESS_HERE",
      "type": "string"
    },
    {
      "key": "issueAmount",
      "value": "10",
      "type": "string"
    },
    {
      "key": "transferFrom",
      "value": "rYOUR_SENDER_ADDRESS_HERE",
      "type": "string"
    },
    {
      "key": "transferTo",
      "value": "rYOUR_RECEIVER_ADDRESS_HERE",
      "type": "string"
    },
    {
      "key": "transferAmount",
      "value": "5",
      "type": "string"
    },
    {
      "key": "xamanPayloadUuid",
      "value": "YOUR_XAMAN_PAYLOAD_UUID_HERE",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "檢查 API 與 XRPL 連線。"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Issued Asset（發幣）",
      "item": [
        {
          "name": "POST Issue ACU（server 代簽，Testnet）",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destination\": \"{{holderAddress}}\",\n  \"amount\": \"{{issueAmount}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/asset/issue",
              "host": ["{{baseUrl}}"],
              "path": ["api", "asset", "issue"]
            },
            "description": "由 .env 的 ISSUER_SEED 直接簽署並送出 Payment，將 ACU 發到 destination。\n\n前置：holder 已對 issuer 建立 Trust Line；.env 已設定 ISSUER_ADDRESS、ISSUER_SEED。"
          },
          "response": []
        },
        {
          "name": "POST Issue ACU Prepare（僅草稿 / 可選 Xaman）",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destination\": \"{{holderAddress}}\",\n  \"amount\": \"{{issueAmount}}\",\n  \"signWithXaman\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/asset/issue/prepare",
              "host": ["{{baseUrl}}"],
              "path": ["api", "asset", "issue", "prepare"]
            },
            "description": "只產生 txjson，不會自動上鏈。若要 issuer 用 Xaman 簽，將 signWithXaman 改為 true（需 XUMM API key）。"
          },
          "response": []
        },
        {
          "name": "GET ACU Balance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/asset/balance/{{holderAddress}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "asset", "balance", "{{holderAddress}}"]
            },
            "description": "發幣後查 holder 的 ACU 餘額。預期 data.balance 為所發數量。"
          },
          "response": []
        },
        {
          "name": "POST Transfer ACU Prepare（用戶轉帳草稿）",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from\": \"{{transferFrom}}\",\n  \"to\": \"{{transferTo}}\",\n  \"amount\": \"{{transferAmount}}\",\n  \"signWithXaman\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/asset/transfer/prepare",
              "host": ["{{baseUrl}}"],
              "path": ["api", "asset", "transfer", "prepare"]
            },
            "description": "用戶之間轉 ACU；需 from 帳號用 Xaman 簽署。雙方皆需 Trust Line。"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Trust Line",
      "item": [
        {
          "name": "POST Trust Line Prepare",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account\": \"{{holderAddress}}\",\n  \"limit\": \"1000000\",\n  \"signWithXaman\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/trustline/prepare",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trustline", "prepare"]
            },
            "description": "建立 TrustSet。signWithXaman: true 時回傳 xaman.qrPng。"
          },
          "response": []
        },
        {
          "name": "GET Trust Lines",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/trustline/{{holderAddress}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trustline", "{{holderAddress}}"]
            },
            "description": "查詢帳號 trust lines。"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Xaman",
      "item": [
        {
          "name": "GET Payload Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/xaman/payload/{{xamanPayloadUuid}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "xaman", "payload", "{{xamanPayloadUuid}}"]
            },
            "description": "輪詢 Xaman 簽署狀態。"
          },
          "response": []
        },
        {
          "name": "POST Submit Signed Payload",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/xaman/payload/{{xamanPayloadUuid}}/submit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "xaman", "payload", "{{xamanPayloadUuid}}", "submit"]
            },
            "description": "簽署完成後提交（若 Xaman 未代廣播）。"
          },
          "response": []
        }
      ]
    }
  ]
}
