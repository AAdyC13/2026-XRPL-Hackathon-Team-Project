{
  "name": "gkc-platform",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "frontend": "concurrently -n www,app \"vite --host -c frontend/homepage/vite.config.ts\" \"vite --host -c frontend/dashboard/vite.config.ts\"",
    "backend": "pnpm server:dev",
    "dev:homepage": "vite --host -c frontend/homepage/vite.config.ts",
    "dev:dashboard": "vite --host -c frontend/dashboard/vite.config.ts",
    "build:homepage": "vite build -c frontend/homepage/vite.config.ts",
    "build:dashboard": "vite build -c frontend/dashboard/vite.config.ts",
    "build:frontend": "pnpm build:homepage && pnpm build:dashboard",
    "admin:dev": "tsx admin/index.ts",
    "admin:start": "node dist/admin/index.js",
    "server:dev": "nest start --watch",
    "build": "prisma generate && nest build -p tsconfig.backend.json && tsc -p tsconfig.backend.json && pnpm build:frontend",
    "start": "node dist/src/main.js",
    "preview": "vite preview --host -c frontend/dashboard/vite.config.ts",
    "preview:homepage": "vite preview --host -c frontend/homepage/vite.config.ts",
    "setup:xrpl": "tsx server/scripts/setup-xrpl.ts",
    "seed:db": "tsx server/scripts/seed-db.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "check": "pnpm check:backend && tsc --noEmit",
    "check:backend": "tsc -p tsconfig.backend.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "vitest run test/api/health.api.spec.ts test/api/auth.api.spec.ts",
    "test:unit": "vitest run test/unit/",
    "test:ci": "vitest run --reporter=verbose",
    "format": "prettier --write ."
  },
