{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "jsx": "react"
  },
  "include": [
    "src/**/*.ts",
    "admin/**/*.ts",
    "admin/**/*.tsx",
    "server/services/**/*.ts",
    "server/routes/**/*.ts",
    "server/middleware/**/*.ts",
    "server/legacy/**/*.ts",
    "prisma/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "client", "client-legacy"]
}
