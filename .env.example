# GKC Platform — Environment Variables
# Copy this file to .env and fill in the values

# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Optional: direct API URL in dev (default: empty → Vite proxy uses PORT above)
# VITE_API_BASE_URL=http://localhost:3001

# ── Database (PostgreSQL) ────────────────────────────────
DATABASE_URL=postgresql://gkc:gkc@localhost:5432/gkc_platform
# Docker Compose variant:
# DATABASE_URL=postgresql://gkc:gkc@postgres:5432/gkc_platform

# ── REDIS ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Docker Compose variant:
# REDIS_URL=redis://redis:6379

# ── JWT ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=2XxuJk4XsVC50HZPKRGFyqJMNQsqHFdQ1WUA4fvs68k9IUMrYqqwT2PYwvT7UK8h
JWT_EXPIRES_IN=86400

# ── XRPL ─────────────────────────────────────────────────
# Network: wss://s.altnet.rippletest.net:51233  (testnet)
#          wss://xrplcluster.com                 (mainnet)
XRPL_WSS=wss://s.altnet.rippletest.net:51233

# GKC Issuer account — issues the GKC IOU token
# Created by: pnpm run setup:xrpl
GKC_ISSUER_ADDRESS=rBeY7pzk4siwXCb6XpVGj9nZ6FcQBdyh79
GKC_ISSUER_SEED=sEd7zB6uhgpPeGWN6EQ2CX6wXxtDMDf

# Platform warm wallet — holds XRP for channel reserves and fees, funded by ISSUER
WARM_WALLET_ADDRESS=rpu6BdcaSiaNejokXeBuDapM6pH4h3VMUy
WARM_WALLET_SEED=sEd7Kro6cRVWwiBMt8Auw6fesagpoQq

# Platform hot wallet — holds GKC, opens Payment Channels, cashes Checks
PLATFORM_ADDRESS=rQ34hishkR9h9EywJAeDTQb1NCXGwKomBM
PLATFORM_SEED=sEdTQKSz5MqjbGcEafTBst7Tx5cnVjm

# Demo user accounts (for testing, pre-funded on testnet faucet)
DEMO_USER_1_ADDRESS=rUkDqw4jdmGZSzsiGsEbEkLs7XES8vi86P
DEMO_USER_1_SEED=sEd7J29jddGA2jHyKSLjjvHQHf8tmu6

DEMO_USER_2_ADDRESS=rN7Dt4zRrZvk5WFecv3F2ckZt1XL2diZPE
DEMO_USER_2_SEED=sEdVR98BBhrVafh9B86cA2z6qqPQJHw

# GKC currency code (do not change)
GKC_CURRENCY=GKC

# ── Xaman (Xumm) ────────────────────────────────────────
XUMM_API_KEY=0f3a574a-6fd3-4216-8eb7-14fa96e5a85a
XUMM_API_SECRET=949b7bae-2845-4daf-ae99-c6bbed14cea8

# ── XRPL Explorer ───────────────────────────────────────
XRPL_EXPLORER=https://testnet.xrpl.org

# ── GKC/XRP Exchange Rate ────────────────────────────────
# How many GKC per 1 XRP for deposits
GKC_PER_XRP=1

# ── Vite dev servers (homepage + dashboard) ───────────────
# Used by frontend/homepage/vite.config.ts and frontend/dashboard/vite.config.ts
# pnpm frontend runs both; or pnpm dev:homepage / pnpm dev:dashboard separately
DEV_HOMEPAGE_PORT=13000
DEV_DASHBOARD_PORT=13001

# ── Frontend URL (for CORS / redirects) ─────────────────
# Dashboard app base URL (include /app path for XUMM return_url)
# Port should match DEV_DASHBOARD_PORT above
FRONTEND_URL=http://localhost:13001/app
# Homepage CTA links to dashboard (production: https://your-domain/app)
VITE_APP_BASE=/app

# ── AdminJS Console ─────────────────────────────────────
ADMIN_PORT=3002
ADMIN_PATH=/
ADMIN_EMAIL=admin@admin.com
# Development only. In production prefer ADMIN_PASSWORD_HASH.
ADMIN_PASSWORD=46MUN5zQhH4wQd5Urv05
# Generate with: node -e "require('bcrypt').hash(process.argv[1], 12).then(console.log)" "your-password"
ADMIN_PASSWORD_HASH=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_COOKIE_SECRET=6d1f2b09e0c801a6bbbe4d03f64f39c47fdf3ec2765e11875a0af56a970f0680
# Optional comma-separated exact IPs, e.g. 127.0.0.1,10.0.0.5
ADMIN_IP_ALLOWLIST=
ADMIN_RATE_LIMIT_MAX=120