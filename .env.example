PORT=3000

# Docker Compose: service hostnames are postgres / redis (not localhost)
DATABASE_URL=postgresql://gkc:gkc@postgres:5432/gkc_platform
REDIS_URL=redis://redis:6379

# Host-only dev (local postgres/redis on published ports):
# DATABASE_URL=postgresql://gkc:gkc@localhost:5432/gkc_platform
# REDIS_URL=redis://localhost:6379

JWT_SECRET=minimum_32_character_random_secret_change_in_production
JWT_EXPIRES_IN=86400

# Bootstrap seeds (optional; applied once per seed id — see docs/DATABASE.md)
# SEED_ADMIN_EMAIL=admin@your-domain.example
# SEED_ADMIN_PASSWORD=ChangeMe123
# SEED_ADMIN_USERNAME=platform_admin
XRPL_WS_URL=wss://s.altnet.rippletest.net:51233
ISSUER_ADDRESS=r...
ISSUER_SEED=s...
CURRENCY_CODE=GKC
DEFAULT_TRUST_LIMIT=1000000
XUMM_API_KEY=
XUMM_API_SECRET=
XUMM_WEBHOOK_URL=
