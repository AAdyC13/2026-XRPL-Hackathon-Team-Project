# GKC Platform — Environment Variables
# Copy this file to .env and fill in the values

# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Optional: direct API URL in dev (default: empty → Vite proxy uses PORT above)
# VITE_API_BASE_URL=http://localhost:3001

# ── Database (PostgreSQL) ────────────────────────────────
DATABASE_URL=postgresql://gkc:gkc@localhost:5432/gkc_platform
# Docker Compose variant:
# DATABASE_URL=postgresql://gkc:gkc@postgres:5432/gkc_platform

# ── REDIS ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Docker Compose variant:
# REDIS_URL=redis://redis:6379

# ── JWT ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_32_char_random_string
JWT_EXPIRES_IN=86400

# ── XRPL ─────────────────────────────────────────────────
# Network: wss://s.altnet.rippletest.net:51233  (testnet)
#          wss://xrplcluster.com                 (mainnet)
XRPL_WSS=wss://s.altnet.rippletest.net:51233

# GKC Issuer account — issues the GKC IOU token
# Created by: pnpm run setup:xrpl
GKC_ISSUER_ADDRESS=
GKC_ISSUER_SEED=

# Warm wallet — treasury / 金庫，接收 Issuer 定期投放的 GKC
WARM_WALLET_ADDRESS=
WARM_WALLET_SEED=

# Platform hot wallet — 自動化與對外營運用熱錢包（Check、Payment、用戶可見地址）
PLATFORM_ADDRESS=
PLATFORM_SEED=

# Demo 用戶鏈上錢包（模擬 user1 / user2，由 setup 或手動建立後填入）
USER1_WALLET_ADDRESS=
USER1_WALLET_SEED=
USER2_WALLET_ADDRESS=
USER2_WALLET_SEED=

# seed-db：demo_user_1 → USER1_WALLET_ADDRESS，demo_user_2 → USER2_WALLET_ADDRESS（勿用 GKC_ISSUER）

# GKC currency code (do not change)
GKC_CURRENCY=GKC

# ── Xaman (Xumm) ────────────────────────────────────────
XUMM_API_KEY=
XUMM_API_SECRET=

# ── XRPL Explorer ───────────────────────────────────────
XRPL_EXPLORER=https://testnet.xrpl.org

# ── GKC/XRP Exchange Rate ────────────────────────────────
# How many GKC per 1 XRP for deposits
GKC_PER_XRP=10

# ── Vite dev servers (homepage + dashboard) ───────────────
# Used by frontend/homepage/vite.config.ts and frontend/dashboard/vite.config.ts
# pnpm frontend runs both; or pnpm dev:homepage / pnpm dev:dashboard separately
DEV_HOMEPAGE_PORT=13000
DEV_DASHBOARD_PORT=13001

# ── Frontend URL (for CORS / redirects) ─────────────────
# Dashboard app base URL (include /app path for XUMM return_url)
# Port should match DEV_DASHBOARD_PORT above
FRONTEND_URL=http://localhost:13001/app
# Homepage CTA links to dashboard (production: https://your-domain/app)
VITE_APP_BASE=/app

# ── AdminJS Console ─────────────────────────────────────
ADMIN_PORT=3002
ADMIN_PATH=/admin
ADMIN_EMAIL=admin@gkc.local
# Development only. In production prefer ADMIN_PASSWORD_HASH.
ADMIN_PASSWORD=change_me_admin_password
# Generate with: node -e "require('bcrypt').hash(process.argv[1], 12).then(console.log)" "your-password"
ADMIN_PASSWORD_HASH=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_COOKIE_SECRET=change_me_to_32_char_random_string
# Optional comma-separated exact IPs, e.g. 127.0.0.1,10.0.0.5
ADMIN_IP_ALLOWLIST=
ADMIN_RATE_LIMIT_MAX=120
